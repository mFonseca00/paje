# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_NAME=paje
DB_USER=paje_user
DB_PASSWORD=sua_senha_aqui

# ANVISA
ANVISA_BASE_URL=https://consultas.anvisa.gov.br
ANVISA_DELAY_SEGUNDOS=1.5
# Tipo de bula a baixar: "paciente" (linguagem simples) ou "profissional" (técnica)
ANVISA_TIPO_BULA=paciente
# Retry para erros transitórios do servidor (5xx): número de tentativas e espera inicial (s)
ANVISA_RETRY_TENTATIVAS=3
ANVISA_RETRY_ESPERA_SEGUNDOS=5.0

# LLM
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Tamanho da janela de contexto do modelo ollama (tokens).
# Ignorado por providers externos (anthropic, openai, gemini).
# qwen2.5:7b suporta até 32768; padrão ollama é 4096 (pode causar truncamento silencioso).
# Recomendado para bulas completas: 16384 ou mais.
LLM_NUM_CTX=4096

# Número máximo de retentativas de validação estrutural do pydantic-ai.
# Se o modelo retornar JSON inválido, o agente retenta até este número de vezes.
# Aumente para 3+ ao usar modelos menores (7B) que podem falhar na primeira tentativa.
LLM_MAX_RESULT_RETRIES=1

# API externa (usado quando LLM_PROVIDER=anthropic, openai ou gemini)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Paths
BULAS_DIR=docs/bulas
RENAME_PATH=docs/RENAME_07-08-2026.xlsx
REFERENCIA_LISTA_A_PATH=docs/medicamentos_referencia_anvisa/lista_referencia_a_11-08-2026.xlsx
REFERENCIA_LISTA_B_PATH=docs/medicamentos_referencia_anvisa/lista_referencia_b_11-08-2026.xlsx

# Versão do prompt ativo
PROMPT_VERSION=v1

# Extração
# Se true, bulas com status ERRO são incluídas automaticamente na fila de extração.
# O flag --reprocessar-erro no CLI ainda funciona como override pontual.
EXTRACAO_REPROCESSAR_ERRO=false

# Pipeline unificado (executar_pipeline.py)
# Desabilite etapas que não devem ser executadas nesta rodada.
PIPELINE_AQUISICAO_HABILITADA=true
PIPELINE_PREPROCESSAMENTO_HABILITADA=true
PIPELINE_EXTRACAO_HABILITADA=true
